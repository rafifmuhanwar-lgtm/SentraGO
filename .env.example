# ============================================
# SENTRAGO — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ── Appwrite Configuration ──
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_DATABASE_ID=your_database_id
APPWRITE_STORAGE_BUCKET_ID=your_bucket_id

# ── Appwrite OAuth (optional — only if using OAuth) ──
APPWRITE_OAUTH_SUCCESS_REDIRECT=appwrite-custom-<PROJECT_ID>://success
APPWRITE_OAUTH_FAILURE_REDIRECT=appwrite-custom-<PROJECT_ID>://failure

# ── Pakasir Payment Gateway (customer app only) ──
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT_SLUG=sentrago
PAKASIR_API_KEY=your_pakasir_api_key

# ── Mapbox (optional — for map features) ──
MAPBOX_ACCESS_TOKEN=your_mapbox_token
